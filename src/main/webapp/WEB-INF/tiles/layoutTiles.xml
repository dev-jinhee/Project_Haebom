<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tiles-definitions PUBLIC
        "-//Apache Software Foundation//DTD Tiles Configuration 3.0//EN"
        "http://tiles.apache.org/dtds/tiles-config_3_0.dtd">
<tiles-definitions>
    <!-- 공통 틀: 페이지별 head, header, 본문, footer, scripts를 조립합니다. -->
    <definition name="tiles/base"
                template="/WEB-INF/views/layouts/default.jsp">
        <put-attribute name="title" value="해봄 | 생활 행정절차 미리연습" />
        <put-attribute name="bodyClass" value="" />
    </definition>

    <!-- 메인 화면은 메인 전용 헤더와 자산을 사용합니다. -->
    <definition name="tiles/main" extends="tiles/base">
        <put-attribute name="title" value="해봄 | 생활 행정절차 미리연습" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/main-head.jsp" />
        <put-attribute name="header" value="/WEB-INF/views/common/header-main.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/main.jsp" />
        <put-attribute name="footer" value="/WEB-INF/views/common/footer.jsp" />
        <put-attribute name="scripts" value="/WEB-INF/views/page-assets/main-scripts.jsp" />
    </definition>
</tiles-definitions>
