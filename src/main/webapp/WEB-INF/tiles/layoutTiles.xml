<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tiles-definitions PUBLIC
        "-//Apache Software Foundation//DTD Tiles Configuration 3.0//EN"
        "http://tiles.apache.org/dtds/tiles-config_3_0.dtd">
<tiles-definitions>
    <!-- 공통 틀: 페이지별 head, header, 본문, footer, scripts를 조립합니다. -->
    <definition name="tiles/base"
                template="/WEB-INF/views/layouts/default.jsp">
        <put-attribute name="title" value="해봄 | 생활 행정절차 미리연습" />
        <put-attribute name="bodyClass" value="" />
    </definition>

    <!-- 메인 화면은 메인 전용 헤더와 자산을 사용합니다. -->
    <definition name="tiles/main" extends="tiles/base">
        <put-attribute name="title" value="해봄 | 생활 행정절차 미리연습" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/main-head.jsp" />
        <put-attribute name="header" value="/WEB-INF/views/common/header-main.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/main.jsp" />
        <put-attribute name="footer" value="/WEB-INF/views/common/footer.jsp" />
        <put-attribute name="scripts" value="/WEB-INF/views/page-assets/main-scripts.jsp" />
    </definition>

    <!-- 일반 사이트 화면 -->
    <definition name="tiles/scenario-list" extends="tiles/base">
        <put-attribute name="title" value="행정절차 연습 | 해봄" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/scenario-list-head.jsp" />
        <put-attribute name="header" value="/WEB-INF/views/common/header.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/scenario/scenario-list.jsp" />
        <put-attribute name="footer" value="/WEB-INF/views/common/footer.jsp" />
        <put-attribute name="scripts" value="/WEB-INF/views/page-assets/scenario-list-scripts.jsp" />
    </definition>

    <definition name="tiles/inquiries" extends="tiles/base">
        <put-attribute name="title" value="문의 게시판 | 해봄" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/inquiries-head.jsp" />
        <put-attribute name="header" value="/WEB-INF/views/common/header.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/inquiries/inquiries.jsp" />
        <put-attribute name="footer" value="/WEB-INF/views/common/footer.jsp" />
        <put-attribute name="scripts" value="/WEB-INF/views/page-assets/inquiries-scripts.jsp" />
    </definition>

    <definition name="tiles/mypage" extends="tiles/base">
        <put-attribute name="title" value="마이페이지 | 해봄" />
        <put-attribute name="bodyClass" value="mypage-page" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/mypage-head.jsp" />
        <put-attribute name="header" value="/WEB-INF/views/common/header.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/member/mypage.jsp" />
        <put-attribute name="footer" value="/WEB-INF/views/common/footer.jsp" />
        <put-attribute name="scripts" value="/WEB-INF/views/page-assets/mypage-scripts.jsp" />
    </definition>

    <!-- 로그인, 가입, 계정 찾기는 공통 사이트 헤더·푸터 없이 표시합니다. -->
    <definition name="tiles/login" extends="tiles/base">
        <put-attribute name="title" value="로그인 | 해봄" />
        <put-attribute name="bodyClass" value="login-page" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/login-head.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/member/login.jsp" />
        <put-attribute name="scripts" value="/WEB-INF/views/page-assets/login-scripts.jsp" />
    </definition>

    <definition name="tiles/signup" extends="tiles/base">
        <put-attribute name="title" value="회원가입 | 해봄" />
        <put-attribute name="bodyClass" value="member-signup-page" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/signup-head.jsp" />
        <put-attribute name="header" value="/WEB-INF/views/header-signup.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/member/signup.jsp" />
        <put-attribute name="scripts" value="/WEB-INF/views/page-assets/signup-scripts.jsp" />
    </definition>

    <definition name="tiles/find-id" extends="tiles/base">
        <put-attribute name="title" value="아이디 찾기 | 해봄" />
        <put-attribute name="bodyClass" value="login-page" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/find-id-head.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/member/find-id.jsp" />
        <put-attribute name="scripts" value="/WEB-INF/views/page-assets/find-id-scripts.jsp" />
    </definition>

    <definition name="tiles/find-password" extends="tiles/base">
        <put-attribute name="title" value="비밀번호 찾기 | 해봄" />
        <put-attribute name="bodyClass" value="login-page" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/find-password-head.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/member/find-password.jsp" />
        <put-attribute name="scripts" value="/WEB-INF/views/page-assets/find-password-scripts.jsp" />
    </definition>

    <!-- 관리자 전용 AdminLTE 화면 -->
    <definition name="tiles/admin" extends="tiles/base">
        <put-attribute name="title" value="관리자 | 해봄" />
        <put-attribute name="bodyClass" value="layout-fixed sidebar-expand-lg bg-body-tertiary admin-page" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/admin-head.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/admin/admin.jsp" />
        <put-attribute name="scripts" value="/WEB-INF/views/page-assets/admin-scripts.jsp" />
    </definition>

    <!-- 관리자 OTP 등록·검증 화면은 사이트 공통 헤더·푸터 없이 표시합니다. -->
    <definition name="tiles/admin-mfa-setup" extends="tiles/base">
        <put-attribute name="title" value="관리자 OTP 등록 | 해봄" />
        <put-attribute name="bodyClass" value="login-page" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/admin-mfa-setup-head.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/admin/mfa-setup.jsp" />
    </definition>

    <definition name="tiles/admin-mfa-verify" extends="tiles/base">
        <put-attribute name="title" value="관리자 2단계 인증 | 해봄" />
        <put-attribute name="bodyClass" value="login-page" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/admin-mfa-verify-head.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/admin/mfa-verify.jsp" />
    </definition>

    <!-- 시뮬레이션 본 화면과 인쇄 창은 각각 화면 전용 자산을 사용합니다. -->
    <definition name="tiles/simulation" extends="tiles/base">
        <put-attribute name="title" value="시뮬레이션 | 해봄" />
        <put-attribute name="bodyClass" value="simulation-page" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/simulation-head.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/scenario/simulation.jsp" />
        <put-attribute name="scripts" value="/WEB-INF/views/page-assets/simulation-scripts.jsp" />
    </definition>

    <definition name="tiles/simulation-print" extends="tiles/base">
        <put-attribute name="title" value="해봄 | 시뮬레이션 화면 인쇄" />
        <put-attribute name="bodyClass" value="simulation-page simulation-print-page" />
        <put-attribute name="head" value="/WEB-INF/views/page-assets/simulation-print-head.jsp" />
        <put-attribute name="content" value="/WEB-INF/views/pages/scenario/simulation-print.jsp" />
        <put-attribute name="scripts" value="/WEB-INF/views/page-assets/simulation-print-scripts.jsp" />
    </definition>
</tiles-definitions>
