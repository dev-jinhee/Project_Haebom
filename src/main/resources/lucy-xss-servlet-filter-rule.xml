<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.navercorp.com/lucy-xss-servlet">
    <defenders>
        <!-- 🛡️ 해봄 전역 XSS 디펜더: 태그(<, >)는 막고 작은따옴표(')는 보존 -->
        <defender>
            <name>safeXssDefender</name>
            <class>kr.co.oti.haebom.system.config.SafeXssDefender</class>
        </defender>
    </defenders>

    <!-- Default Defender: 전역(/*) 모든 요청에 safeXssDefender 적용 -->
    <default>
        <defender>safeXssDefender</defender>
    </default>

    <!-- 전역 파라미터 예외: 주소 관련 데이터는 특수문자 원본 그대로 보존 -->
    <global>
        <params>
            <param name="roadFullAddr" useDefender="false" />
            <param name="roadAddrPart1" useDefender="false" />
            <param name="addrDetail" useDefender="false" />
            <param name="jibunAddr" useDefender="false" />
        </params>
    </global>

    <!-- URL 예외: 행안부 공식 주소 팝업 콜백 URL은 필터링에서 완전 제외! -->
    <url-rule-set>
        <url-rule>
            <url>/login</url>
            <params>
                <param name="password" useDefender="false" />
            </params>
        </url-rule>

        <url-rule>
            <url>/api/mypage/password</url>
            <params>
                <param name="currentPassword" useDefender="false" />
                <param name="newPassword" useDefender="false" />
                <param name="passwordConfirm" useDefender="false" />
            </params>
        </url-rule>

        <url-rule>
            <url>/api/members/join</url>
            <params>
                <param name="password" useDefender="false" />
            </params>
        </url-rule>

        <url-rule>
            <url>/api/members/recovery/find-password/reset</url>
            <params>
                <param name="newPassword" useDefender="false" />
                <param name="passwordConfirm" useDefender="false" />
            </params>
        </url-rule>

        <url-rule>
            <url disable="true">/address/juso/popup</url>
        </url-rule>
    </url-rule-set>
</config>
