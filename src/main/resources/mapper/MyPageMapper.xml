<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
    
<mapper namespace="kr.co.oti.haebom.mapper.MyPageMapper">

    <select id="selectProfileByMemberId"
            resultType="kr.co.oti.haebom.dto.MyPageProfileResponseDTO">
        SELECT
            member_name,
            login_id,
            email,
            birth_date,
            gender,
            created_at
        FROM member
        WHERE member_id = #{memberId}
          AND member_status = 'ACTIVE'
    </select>
    
</mapper>